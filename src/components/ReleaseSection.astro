---
    import PlayStation from '../assets/ps5.svg';
    import Xbox from '../assets/xbox.svg';
    import Keep from '../assets/keep-scrolling.svg';
---

<section class=" release-section w-full max-w-250 mx-auto flex flex-col md:flex-row items-center justify-between gap-6 md:gap-0 px-4 md:px-0 pt-4 md:pt-2 pb-8 md:pb-4">
    <div class=" release-date text-white font-bold text-base md:text-[22px] text-center md:text-left leading-tight">
        <p>DISPONIBLE</p>
        <p>19 NOVIEMBRE 2026</p>
    </div>
    <div class="relative flex  flex-col items-center gap-3 md:-translate-x-4">
        <button class="reserve-button bg-[#f4b5ca] text-[#574a5a] font-bold text-base md:text-lg px-5 py-3 md:py-4 rounded-full">
            Resérvalo ya
        </button>
        <Keep class="release-arrow absolute top-full mt-3 w-10 h-auto text-[#f4b5ca]" />
        
    </div>
    
    <div class="flex  flex-col items-center gap-2 mt-8 md:mt-0">
        <PlayStation class="w-24 md:w-30 h-auto text-white"/>
        <Xbox class="w-30 md:w-37.5 h-auto text-white"/>
        

    </div>

</section>

    
