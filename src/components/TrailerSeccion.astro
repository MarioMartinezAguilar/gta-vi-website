---
 import  PlayButton from  '../assets/play-button.svg';
---

<section id="trailer"class="trailer-section fixed inset-0 z-0 w-full h-screen overflow-hidden opacity-0 pointer-events-none">

    <img
        src="/images/desktop/image-scroll.avif"
        alt="Tráiler GTA VI"
        class="trailer-image absolute inset-0 w-full h-full object-contain md:object-cover scale-[1.15] md:scale-100"
    >
    <div class="absolute top-16 md:top-20 left-0 w-full z-10 text-center text-white px-4">
        <p class="font-bold text-base md:text-xl">VER AHORA</p>
        <h2 class="text-2xl md:text-5xl font-extrabold tracking-[0.08em] md:tracking-[0.12em] mt-3">TRÁILER DE LANZAMIENTO</h2>
    </div>
    <div class="absolute inset-0 flex items-center justify-center z-10">
        <PlayButton class="w-16 h-16 md:w-27 md:h-27 text-white" />
    </div>

</section>