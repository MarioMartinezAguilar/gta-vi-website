---
 import PlayButton from  '../assets/play-button.svg';
---

<section class="card-section w-full min-h-screen bg-[#080d19] flex items-center justify-center px-6 py-24">
    <div class="w-full max-w-300">
    
        <div class=" flex gap-4 overflow-x-auto  snap-mandatory px-2 md:grid md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0">
            <article class="card-item relative shrink-0 w-[82%] md:w-auto aspect-[3/4.25] overflow-hidden rounded-xl cursor-pointer snap-center">
                <img 
                    src="/images/desktop/image-scroll2.avif" 
                    alt="Escena de GTA VI"
                    class="absolute inset-0 w-full h-full object-cover
                    mask-[linear-gradient(to_bottom,black_0%,black_85%,transparent_100%)]"
                >
                <div class="absolute inset-0 bg-linear-to-t from-[#b5a5e8]/90 via-transparent to-transparent"></div>
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-black/10"></div>
                <div class="card-shine absolute inset-0 pointer-events-none"></div>
                <div  class=" absolute inset-0 flex items-center justify-center">
                <PlayButton class="w-16 h-16 text-white" />
                </div>

                <div class="absolute bottom-12 left-4 right-4 text-center text-white">
                    <p class="font-bold text-sm mb-3">VER AHORA</p>
                    <h2 class="font-extrabold text-2xl leading-tight text-[#ffe4a6]">
                        UNA MIRADA<br />EXTENDIDA
                    </h2>
                </div>
            </article>
            
            <article class="card-item relative shrink-0 w-[82%] md:w-auto aspect-[3/4.25] overflow-hidden rounded-xl cursor-pointer snap-center">

                <img
                    src="/images/desktop/imagen-scroll3.avif"
                    alt="Tráiler 2 de GTA VI"
                    class="absolute inset-0 w-full h-full object-cover
                    mask-[linear-gradient(to_bottom,black_0%,black_85%,transparent_100%)]"
                    
                >
                <div class="absolute inset-0 bg-linear-to-t from-[#b5a5e8]/90 via-transparent to-transparent"></div>

                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-black/10"></div>
                <div class="card-shine absolute inset-0 pointer-events-none"></div>

                <div  class=" absolute inset-0 flex items-center justify-center">
                <PlayButton class="w-16 h-16 text-white" />
                </div>
                <div class="absolute bottom-12 left-4 right-4 text-center text-white">
                    <p class="font-bold text-sm mb-3">VER AHORA</p>
                    <h2 class="font-extrabold text-2xl leading-tight text-[#ffe4a6]">
                        TRÁILER 2
                    </h2>
                </div>
            </article>


            <article class="card-item relative shrink-0 w-[82%] md:w-auto aspect-[3/4.25] overflow-hidden rounded-xl cursor-pointer snap-center">

                <img
                    src="/images/desktop/imagen-scroll4.avif"
                    alt="Tráiler 1 de GTA VI"
                    class="absolute inset-0 w-full h-full object-cover
                    [mask-image:linear-gradient(to_bottom,black_0%,black_85%,transparent_100%)]"
                >
                <div class="absolute inset-0 bg-linear-to-t from-[#b5a5e8]/90 via-transparent to-transparent"></div>
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-black/10"></div>

                <div class="card-shine absolute inset-0 pointer-events-none"></div>

                <div  class=" absolute inset-0 flex items-center justify-center">
                <PlayButton class="w-16 h-16 text-white" />
                </div>

                <div class="absolute bottom-12 left-4 right-4 text-center text-white">
                    <p class="font-bold text-sm mb-3">VER AHORA</p>
                    <h2 class="font-extrabold text-2xl leading-tight text-[#ffe4a6]">
                        TRÁILER 1
                    </h2>
                </div>


            </article>


        </div>

        

    </div>

</section>

